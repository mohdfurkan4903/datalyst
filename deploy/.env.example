# Copy to deploy/.env and fill in. Never commit deploy/.env.
# Only what is needed to start lives here. The AI model, API keys and every other
# option are set by an admin on the Settings page after the first sign-in.

# Public address. ":80" serves plain HTTP on any host name.
# Use a real domain (for example datalyst.example.com) and Caddy gets an HTTPS certificate automatically.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Password for the bundled Postgres metastore. Use a long random value.
METASTORE_PASSWORD=

# Scale
API_WORKERS=2
WORKER_REPLICAS=1
