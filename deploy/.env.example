# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Public address. ":80" serves plain HTTP on any host name.
# Use a real domain (for example datalyst.example.com) and Caddy gets an HTTPS certificate automatically.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Database password for the bundled metastore. Use a long random value.
METASTORE_PASSWORD=

# Encrypts stored connection URLs and signs sign-in tokens. Create with:
#   docker compose run --rm --no-deps api secret-key
# Keep a copy somewhere safe: losing it means re-entering every connection.
DATALYST_SECRET_KEY=

# First admin, created on first start if no users exist. Remove the password afterwards.
DATALYST_BOOTSTRAP_ADMIN_EMAIL=
DATALYST_BOOTSTRAP_ADMIN_PASSWORD=

# Model that answers questions.
DATALYST_LLM_PROVIDER=openai
DATALYST_LLM_MODEL=gpt-4.1-mini
DATALYST_LLM_API_KEY=
DATALYST_LLM_BASE_URL=

# Optional cheaper model for background descriptions; empty uses the model above.
DATALYST_DESCRIBE_LLM_PROVIDER=
DATALYST_DESCRIBE_LLM_MODEL=
DATALYST_DESCRIBE_LLM_API_KEY=

# Optional embeddings for meaning-based search; empty turns them off.
DATALYST_EMBEDDING_PROVIDER=
DATALYST_EMBEDDING_MODEL=
DATALYST_EMBEDDING_API_KEY=

# Scale
API_WORKERS=2
WORKER_REPLICAS=1
